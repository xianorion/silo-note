{
  "name": "silo-note",
  "version": "1.1.0",
  "description": "A notepad app for creatives",
  "private": true,
  "main": "./public/electron.js",
  "author": "Mack Cunningham",
  "homepage": "./",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@tiptap/extension-history": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "buffer": "^6.0.3",
    "cross-env": "^7.0.3",
    "electronmon": "^2.0.3",
    "electron": "43.2.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "generate:icons": "node ./scripts/generate-icons.js",
    "start": "export BROWSER=none && react-scripts start",
    "electron": "electron .",
    "build": "npm run generate:icons && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "package": "npm run generate:icons && electron-packager .",
    "electron:start": "concurrently -k \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electronmon .\"",
    "electron:package:mac": "npm run generate:icons && npm run build && electron-builder -m -c.extraMetadata.main=build/electron.js",
    "electron:package:win": "npm run generate:icons && npm run build && electron-builder -w -c.extraMetadata.main=build/electron.js",
    "electron:package:linux": "npm run generate:icons && npm run build && electron-builder --linux --arm64 --publish never -c.extraMetadata.main=build/electron.js"
  },
  "build": {
    "appId": "com.electron.silonote",
    "productName": "SiloNote",
    "files": [
      "build/*",
      "build/**/*",
      "src/**/*",
      "src/styles/*",
      "public/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icons"
    }
  },

  "scripts": {
    "start": "cross-env BROWSER=none && react-scripts start",
    "startw": "export BROWSER=none && react-scripts start",
    "electron": "electron .",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "package": "electron-packager .",
    "electron:start": "concurrently -k \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electronmon .\"",
    "electron:package:mac": "npm run build && electron-builder -m -c.extraMetadata.main=build/electron.js",
    "electron:package:win": "npm run build && electron-builder -w -c.extraMetadata.main=build/electron.js",
    "electron:package:linux": "npm run build && electron-builder --linux --arm64 --publish never -c.extraMetadata.main=build/electron.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "last 1 electron version",
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 electron version",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^6.4.0",
    "css-loader": "^7.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^23.0.2",
    "electron-is-dev": "^3.0.1",
    "electron-packager": "^17.1.2",
    "png2icons": "^2.0.1",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "wait-on": "^6.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
